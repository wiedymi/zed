diff --git a/ohos-pwd.c b/ohos-pwd.c
new file mode 100644
index 0000000..ef9b242
--- /dev/null
+++ b/ohos-pwd.c
@@ -0,0 +1,43 @@
+/* HarmonyOS application UIDs do not have entries in /etc/passwd. */
+
+#include "includes.h"
+
+#include <sys/types.h>
+
+#include <pwd.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+#include "ohos-pwd.h"
+
+static char *
+environment_or_default(const char *name, char *fallback)
+{
+	char *value = getenv(name);
+
+	return value != NULL && *value != '\0' ? value : fallback;
+}
+
+struct passwd *
+ohos_getpwuid(uid_t uid)
+{
+	struct passwd *system_user = getpwuid(uid);
+	static char default_name[] = "zed";
+	static char default_password[] = "*";
+	static char default_home[] = "/data/app";
+	static char default_shell[] = "/system/bin/sh";
+	static char default_gecos[] = "Zed";
+	static struct passwd user;
+
+	if (system_user != NULL || uid != getuid())
+		return system_user;
+
+	user.pw_name = environment_or_default("USER", default_name);
+	user.pw_passwd = default_password;
+	user.pw_uid = uid;
+	user.pw_gid = getgid();
+	user.pw_gecos = default_gecos;
+	user.pw_dir = environment_or_default("HOME", default_home);
+	user.pw_shell = environment_or_default("SHELL", default_shell);
+	return &user;
+}
diff --git a/ohos-pwd.h b/ohos-pwd.h
