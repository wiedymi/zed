+static char *zed_ohos_private_git_dir(const char *work_tree)
+{
+	const char *metadata_root = getenv("ZED_OHOS_GIT_METADATA_ROOT");
+	struct strbuf path = STRBUF_INIT;
+	char *absolute_work_tree;
+	const unsigned char *byte;
+
+	if (!metadata_root || !*metadata_root)
+		return NULL;
+	if (!is_absolute_path(metadata_root))
+		die("ZED_OHOS_GIT_METADATA_ROOT must be an absolute path");
+
+	absolute_work_tree = absolute_pathdup(work_tree);
+	strbuf_addstr(&path, metadata_root);
+	strbuf_complete(&path, '/');
+	for (byte = (const unsigned char *)absolute_work_tree; *byte; byte++)
+		strbuf_addf(&path, "%02x", *byte);
+	free(absolute_work_tree);
+
+	return strbuf_detach(&path, NULL);
+}
